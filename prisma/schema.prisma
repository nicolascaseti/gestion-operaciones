generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== AUTENTICACION ====================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  paymentMethods PaymentMethod[]
  purchases      Purchase[]
  sales          Sale[]
  whatsappConfig WhatsAppConfig?

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("user") // admin, user
  tenantId      String    @map("tenant_id")
  emailVerified DateTime? @map("email_verified")
  whatsappPhone String?   @map("whatsapp_phone") // Numero de WhatsApp vinculado
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([whatsappPhone])
  @@map("users")
}

// Configuracion de WhatsApp Business API por tenant
model WhatsAppConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique @map("tenant_id")
  phoneNumberId       String?  @map("phone_number_id") // ID del numero en Meta
  accessToken         String?  @map("access_token") // Token de acceso
  webhookVerifyToken  String   @map("webhook_verify_token") // Token para verificar webhook
  isActive            Boolean  @default(false) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_config")
}

// ==================== CATALOGOS ====================

model Product {
  id            Int      @id @default(autoincrement())
  tenantId      String   @map("tenant_id")
  codigo        String
  nombre        String
  categoria     String?
  descripcion   String?
  imagen        String?
  costoDefault  Decimal  @default(0) @map("costo_default")
  precioDefault Decimal  @default(0) @map("precio_default")
  stockInicial  Decimal  @default(0) @map("stock_inicial")
  stockMinimo   Decimal  @default(0) @map("stock_minimo")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  compras Purchase[]
  ventas  Sale[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("productos")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  compras Purchase[]

  @@index([tenantId])
  @@map("proveedores")
}

model Customer {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventas Sale[]

  @@index([tenantId])
  @@map("clientes")
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventas Sale[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("formas_pago")
}

// ==================== TRANSACCIONES ====================

model Purchase {
  id             Int      @id @default(autoincrement())
  tenantId       String   @map("tenant_id")
  fecha          DateTime
  proveedorId    Int      @map("proveedor_id")
  productoId     Int      @map("producto_id")
  codigoProducto String   @map("codigo_producto")
  nombreProducto String   @map("nombre_producto")
  cantidad       Decimal
  costoUnitario  Decimal  @map("costo_unitario")
  costoTotal     Decimal  @map("costo_total")
  notas          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedor Supplier @relation(fields: [proveedorId], references: [id])
  producto  Product  @relation(fields: [productoId], references: [id])

  @@index([tenantId])
  @@index([fecha])
  @@index([proveedorId])
  @@index([productoId])
  @@map("compras")
}

model Sale {
  id               Int      @id @default(autoincrement())
  tenantId         String   @map("tenant_id")
  fecha            DateTime
  formaPagoId      Int      @map("forma_pago_id")
  clienteId        Int      @map("cliente_id")
  productoId       Int      @map("producto_id")
  codigoProducto   String   @map("codigo_producto")
  nombreProducto   String   @map("nombre_producto")
  unidades         Decimal
  precioUnitario   Decimal  @map("precio_unitario")
  ventaTotal       Decimal  @map("venta_total")
  costoAsignado    Decimal  @map("costo_asignado")
  ganancia         Decimal
  margenPorcentaje Decimal  @map("margen_porcentaje")
  notas            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formaPago PaymentMethod @relation(fields: [formaPagoId], references: [id])
  cliente   Customer      @relation(fields: [clienteId], references: [id])
  producto  Product       @relation(fields: [productoId], references: [id])

  @@index([tenantId])
  @@index([fecha])
  @@index([clienteId])
  @@index([formaPagoId])
  @@index([productoId])
  @@map("ventas")
}
